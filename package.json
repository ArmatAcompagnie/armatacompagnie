{
  "name": "asso-cascade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "build": "tsc -b && vite build",
    "build:gh": "cross-env DEPLOY_TARGET=gh npm run build",
    "build:cf": "cross-env DEPLOY_TARGET=cf npm run build",
    "lint": "eslint .",
    "preview": "vite preview --port 3000 --open",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "format": "prettier . --write"
  },
  "dependencies": {
    "@fullcalendar/bootstrap5": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@hcaptcha/react-hcaptcha": "^1.12.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "reactstrap": "^9.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.8.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8"
  }
}
